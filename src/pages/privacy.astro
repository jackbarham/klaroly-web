---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout
  title="Privacy | Klaroly"
  description="Klaroly privacy policy."
  noindex={true}
>
  <div class="mx-auto max-w-4xl px-5 sm:px-8">
    <section class="pt-16 pb-2 sm:pt-24">
      <h1 class="text-4xl leading-[1.1] font-semibold tracking-tight sm:text-5xl">
        Privacy
      </h1>
    </section>
    <div class="prose max-w-2xl">
      <p>
        Coming shortly. This page is being written and will be here before the
        early access list opens.
      </p>
      <p>
        In the meantime, if you have a question about what we do with your
        information, email
        <a href="mailto:hello@klaroly.com">hello@klaroly.com</a> and we will answer
        it properly.
      </p>
    </div>
  </div>
</BaseLayout>
