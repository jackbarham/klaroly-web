---
import BaseLayout from '../layouts/BaseLayout.astro'
import PageHeader from '../components/PageHeader.astro'
import { site } from '../site'
---

<BaseLayout title={`Privacy | ${site.name}`} description="Klaroly privacy policy." noindex={true}>
  <PageHeader title="Privacy" />
  <div class="prose max-w-2xl">
    <p>
      Coming shortly. This page is being written and will be here before the
      early access list opens.
    </p>
    <p>
      In the meantime, if you have a question about what we do with your
      information, email
      <a href={`mailto:${site.email}`}>{site.email}</a> and we will answer
      it properly.
    </p>
  </div>
</BaseLayout>
