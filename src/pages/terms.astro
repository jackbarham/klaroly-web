---
import BaseLayout from '../layouts/BaseLayout.astro'
import PageHeader from '../components/PageHeader.astro'
import { site } from '../site'
---

<BaseLayout title={`Terms | ${site.name}`} description="Klaroly terms of use." noindex={true}>
  <PageHeader title="Terms" />
  <div class="prose max-w-2xl">
    <p>
      Coming shortly. This page is being written and will be here before anybody
      can sign up.
    </p>
    <p>
      Questions in the meantime to
      <a href={`mailto:${site.email}`}>{site.email}</a>.
    </p>
  </div>
</BaseLayout>
