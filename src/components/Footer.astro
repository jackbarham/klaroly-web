---
import { site } from '../site'

const year = new Date().getFullYear()
const links = [...site.nav, ...site.legalNav]
const { company } = site
---

<footer
  class="mt-24 border-t border-[var(--color-line)]"
>
  <div
    class="mx-auto max-w-4xl px-5 py-10 text-sm text-[var(--color-muted)] sm:px-8"
  >
    <nav aria-label="Footer" class="flex flex-wrap gap-x-6 gap-y-2">
      {
        links.map(link => (
          <a
            href={link.href}
            class="hover:text-[var(--color-ink)]"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <p class="mt-6">
      <a
        href={`mailto:${site.email}`}
        class="font-medium text-[var(--color-ink)] underline decoration-[var(--color-accent)] decoration-2 underline-offset-4"
        >{site.email}</a
      >
    </p>

    <p class="mt-4 leading-relaxed">
      {site.name} is a product of {company.name}, registered in {company.jurisdiction},
      company number {company.number}.
      <br />
      Registered office: {company.address.street}, {company.address.locality},
      {company.address.postcode}.
    </p>

    <p class="mt-4">&copy; {year} {company.name}</p>
  </div>
</footer>
