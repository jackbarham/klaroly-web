---
/**
 * Fixed header. Hides on scroll down, returns on scroll up. On small screens
 * the nav slides down from behind the bar with staggered links and a Login
 * button pinned at the bottom. Timings follow the FitThis reference header.
 *
 * Height is --header-h (set in global.css); BaseLayout pads the page by it.
 */
import { site } from '../site'

const path = Astro.url.pathname
const isCurrent = (href: string) => path === href || path === `${href}/`
---

<header
  id="site-header"
  class="group fixed top-0 left-0 z-50 w-full border-b border-[var(--color-line)] transition-transform duration-400 ease-in-out data-hidden:-translate-y-full motion-reduce:transition-none"
>
  <!-- Bar -->
  <div class="relative z-50 bg-[var(--color-paper)]">
    <div
      class="mx-auto flex h-[var(--header-h)] max-w-4xl items-center justify-between px-5 sm:px-8 md:grid md:grid-cols-[1fr_auto_1fr]"
    >
      <a
        href="/"
        class="text-2xl font-semibold tracking-tight md:text-3xl"
        aria-label={`${site.name} home`}
        data-menu-close
      >
        {site.name}
      </a>

      <!-- Desktop navigation -->
      <nav aria-label="Main" class="hidden md:block">
        <ul class="flex items-center gap-6 lg:gap-10">
          {
            site.nav.map(link => (
              <li>
                <a
                  href={link.href}
                  aria-current={isCurrent(link.href) ? 'page' : undefined}
                  class="group/link relative block py-1 font-medium tracking-wide"
                >
                  <span class="block">{link.label}</span>
                  <span
                    class:list={[
                      'absolute bottom-0 left-0 h-0.5 w-full origin-left bg-[var(--color-accent)] opacity-90 transition-transform duration-200 ease-in-out',
                      isCurrent(link.href) ? 'scale-x-100' : 'scale-x-0 group-hover/link:scale-x-100'
                    ]}
                  />
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Desktop login -->
      <a
        href={site.appLoginUrl}
        class="hidden h-12 items-center justify-self-end rounded-md bg-[var(--color-ink)] px-6 font-medium tracking-wide text-[var(--color-paper)] transition-colors duration-300 hover:bg-[var(--color-accent)] md:inline-flex"
      >
        Login
      </a>

      <!-- Burger -->
      <button
        type="button"
        id="menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-navigation"
        aria-label="Toggle menu"
        class="relative z-50 flex h-8 w-8 cursor-pointer flex-col items-end justify-center gap-1.5 md:hidden"
      >
        <span
          class="block h-[3px] w-7 bg-[var(--color-ink)] transition-all duration-300 group-data-open:translate-y-[9px] group-data-open:rotate-45"
        ></span>
        <span
          class="block h-[3px] w-5 bg-[var(--color-ink)] transition-all duration-300 group-data-open:opacity-0"
        ></span>
        <span
          class="block h-[3px] w-7 bg-[var(--color-ink)] transition-all duration-300 group-data-open:-translate-y-[9px] group-data-open:-rotate-45"
        ></span>
      </button>
    </div>
  </div>

  <!-- Mobile navigation, sits behind the bar and slides down from it -->
  <nav
    id="mobile-navigation"
    aria-label="Mobile"
    class="mobile-nav absolute top-[var(--header-h)] left-0 -z-10 h-[calc(100dvh-var(--header-h))] w-full -translate-y-full bg-[var(--color-paper)] px-5 py-6 transition-transform duration-300 ease-in-out group-data-open:translate-y-0 sm:px-8 md:hidden motion-reduce:transition-none"
  >
    <ul class="space-y-2">
      {
        site.nav.map((link, i) => (
          <li
            class="translate-x-4 opacity-0 transition-all duration-300 ease-in-out group-data-open:translate-x-0 group-data-open:opacity-100 motion-reduce:transition-none"
            style={`--delay: ${200 + i * 90}ms`}
          >
            <a
              href={link.href}
              aria-current={isCurrent(link.href) ? 'page' : undefined}
              class="block py-2 text-[21px] font-semibold tracking-wide"
              data-menu-close
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div
      class="mobile-cta absolute inset-x-5 bottom-6 opacity-0 transition-opacity ease-in-out group-data-open:opacity-100 sm:inset-x-8 motion-reduce:transition-none"
    >
      <a
        href={site.appLoginUrl}
        class="flex h-16 w-full items-center justify-center rounded-md bg-[var(--color-ink)] px-12 text-xl font-medium text-[var(--color-paper)] transition-colors duration-300 hover:bg-[var(--color-accent)]"
      >
        Login
      </a>
    </div>
  </nav>
</header>

<style>
  /* Staggered link entrance. Delay only applies on open, matching the reference. */
  .mobile-nav li {
    transition-delay: 0ms;
  }
  [data-open] .mobile-nav li {
    transition-delay: var(--delay);
  }

  /* Button fades in late and out fast. */
  .mobile-cta {
    transition-duration: 150ms;
    transition-delay: 0ms;
  }
  [data-open] .mobile-cta {
    transition-duration: 700ms;
    transition-delay: 400ms;
  }
</style>

<script>
  const SCROLL_THRESHOLD = 50

  const header = document.getElementById('site-header')!
  const toggle = document.getElementById('menu-toggle')!

  // Mobile menu
  const setOpen = (open: boolean) => {
    header.toggleAttribute('data-open', open)
    toggle.setAttribute('aria-expanded', String(open))
    document.body.classList.toggle('overflow-hidden', open)
  }
  const isOpen = () => header.hasAttribute('data-open')

  toggle.addEventListener('click', () => setOpen(!isOpen()))
  header.querySelectorAll('[data-menu-close]').forEach(el => {
    el.addEventListener('click', () => setOpen(false))
  })
  window.addEventListener('resize', () => {
    if (isOpen()) setOpen(false)
  })
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && isOpen()) setOpen(false)
  })

  // Hide on scroll down, show on scroll up, always show near the top
  let lastScrollY = window.scrollY
  window.addEventListener(
    'scroll',
    () => {
      const y = window.scrollY
      if (y <= SCROLL_THRESHOLD) {
        header.removeAttribute('data-hidden')
      } else if (y > lastScrollY) {
        header.setAttribute('data-hidden', '')
      } else if (y < lastScrollY) {
        header.removeAttribute('data-hidden')
      }
      lastScrollY = y
    },
    { passive: true }
  )
</script>
