---
// TODO: set this once the form handler exists. Ticket K-12.
// While it is empty the form posts back to the current page and captures nothing.
// The site must not go live with this unset.
const FORM_ENDPOINT = ''

interface Props {
  id?: string
  note?: boolean
  class?: string
}

const { id = 'early-access', note = true, class: className = '' } = Astro.props
---

<form
  action={FORM_ENDPOINT || undefined}
  method="post"
  class:list={['max-w-md', className]}
  aria-label="Early access sign up"
>
  <label class="block text-sm font-medium" for={`${id}-email`}>Email</label>

  <div class="mt-1.5 flex flex-col gap-3 sm:flex-row">
    <input
      id={`${id}-email`}
      name="email"
      type="email"
      autocomplete="email"
      required
      placeholder="you@example.com"
      class="w-full rounded-md border border-[var(--color-line)] bg-transparent px-3.5 py-2.5 text-[1.0625rem] outline-none focus:border-[var(--color-accent)] focus:ring-1 focus:ring-[var(--color-accent)] dark:border-[var(--color-line-dark)] dark:focus:border-[var(--color-accent-dark)] dark:focus:ring-[var(--color-accent-dark)]"
    />
    <button
      type="submit"
      class="shrink-0 rounded-md bg-[var(--color-ink)] px-5 py-2.5 text-[1.0625rem] font-medium text-[var(--color-paper)] transition-opacity hover:opacity-90 dark:bg-[var(--color-ink-dark)] dark:text-[var(--color-paper-dark)]"
    >
      Join early access
    </button>
  </div>

  {
    note && (
      <p class="mt-3 text-sm leading-relaxed text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]">
        Extended free trial, free use during beta, and early access pricing held
        for good.
      </p>
    )
  }
</form>

{/* TODO: stage two, per decision 67. Once the email is captured this is replaced
    in place by an optional follow-up: profile link, weddings a year as bands,
    location, makeup or hair, happy to be emailed. Not built yet. */}
